NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/school_erp
CORS_ORIGINS=http://localhost:3001
SEED_ADMIN_EMAIL=admin@yourschool.example
SEED_ADMIN_PASSWORD=change-me-to-12-plus-chars

JWT_ACCESS_SECRET=<48+ random characters, never committed>
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7


SMS_PROVIDER=console
EMAIL_PROVIDER=console
SCHOOL_NAME=Your School Name


STORAGE_DRIVER=r2
R2_ACCOUNT_ID=<your Cloudflare account id>
R2_ACCESS_KEY_ID=<token access key id>
R2_SECRET_ACCESS_KEY=<token secret>
R2_BUCKET=<your bucket name>