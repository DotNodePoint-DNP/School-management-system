enum AcademicYearStatus {
    PLANNED
    ACTIVE
    CLOSED
}

model AcademicYear {
    id        String             @id @default(uuid(7)) @db.Uuid
    name      String             @unique
    startDate DateTime           @map("start_date") @db.Date
    endDate   DateTime           @map("end_date") @db.Date
    status    AcademicYearStatus @default(PLANNED)
    createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

    terms         Term[]
    classSubjects ClassSubject[]

    @@map("academic_years")
}

model Term {
    id             String   @id @default(uuid(7)) @db.Uuid
    academicYearId String   @map("academic_year_id") @db.Uuid
    name           String
    sequence       Int
    startDate      DateTime @map("start_date") @db.Date
    endDate        DateTime @map("end_date") @db.Date
    createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

    academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

    @@unique([academicYearId, sequence])
    @@unique([academicYearId, name])
    @@map("terms")
}

model SchoolClass {
    id        String   @id @default(uuid(7)) @db.Uuid
    name      String   @unique
    sortOrder Int      @map("sort_order")
    isActive  Boolean  @default(true) @map("is_active")
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

    sections      Section[]
    classSubjects ClassSubject[]

    @@index([sortOrder])
    @@map("classes")
}

model Section {
    id        String   @id @default(uuid(7)) @db.Uuid
    classId   String   @map("class_id") @db.Uuid
    name      String
    capacity  Int?
    isActive  Boolean  @default(true) @map("is_active")
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

    schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Restrict)

    @@unique([classId, name])
    @@map("sections")
}

model Subject {
    id        String   @id @default(uuid(7)) @db.Uuid
    code      String   @unique
    name      String
    isActive  Boolean  @default(true) @map("is_active")
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

    classSubjects ClassSubject[]

    @@map("subjects")
}

model ClassSubject {
    academicYearId String  @map("academic_year_id") @db.Uuid
    classId        String  @map("class_id") @db.Uuid
    subjectId      String  @map("subject_id") @db.Uuid
    isCompulsory   Boolean @default(true) @map("is_compulsory")

    academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
    schoolClass  SchoolClass  @relation(fields: [classId], references: [id], onDelete: Restrict)
    subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)

    @@id([academicYearId, classId, subjectId])
    @@index([classId])
    @@index([subjectId])
    @@map("class_subjects")
}
