enum AcademicYearStatus {
    PLANNED
    ACTIVE
    CLOSED
}

model AcademicYear {
    id        String             @id @default(uuid(7)) @db.Uuid
    name      String             @unique
    startDate DateTime           @map("start_date") @db.Date
    endDate   DateTime           @map("end_date") @db.Date
    status    AcademicYearStatus @default(PLANNED)
    createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

    terms                   Term[]
    classSubjects           ClassSubject[]
    classTeacherAssignments ClassTeacherAssignment[]
    teachingAssignments     TeachingAssignment[]
    enrollments             Enrollment[]

    weeklyOffDays            Int[]               @default([0, 6]) @map("weekly_off_days")
    attendanceEditWindowDays Int                 @default(1) @map("attendance_edit_window_days")
    calendarEntries          CalendarEntry[]
    attendanceSessions       AttendanceSession[]
    exams                    Exam[]
    resultPolicies           ResultPolicy[]
    promotionsFrom           PromotionRun[]      @relation("PromotionFrom")
    promotionsTo             PromotionRun[]      @relation("PromotionTo")

    @@map("academic_years")
}

model Term {
    id             String   @id @default(uuid(7)) @db.Uuid
    academicYearId String   @map("academic_year_id") @db.Uuid
    name           String
    sequence       Int
    startDate      DateTime @map("start_date") @db.Date
    endDate        DateTime @map("end_date") @db.Date
    createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

    academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
    exams        Exam[]

    @@unique([academicYearId, sequence])
    @@unique([academicYearId, name])
    @@map("terms")
}

model SchoolClass {
    id        String   @id @default(uuid(7)) @db.Uuid
    name      String   @unique
    sortOrder Int      @map("sort_order")
    isActive  Boolean  @default(true) @map("is_active")
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

    sections         Section[]
    classSubjects    ClassSubject[]
    resultPolicies   ResultPolicy[]
    nextClassId      String?             @map("next_class_id") @db.Uuid
    nextClass        SchoolClass?        @relation("ClassProgression", fields: [nextClassId], references: [id], onDelete: Restrict)
    previousClasses  SchoolClass[]       @relation("ClassProgression")
    promotionTargets PromotionDecision[] @relation("DecisionToClass")

    @@index([sortOrder])
    @@map("classes")
}

model Section {
    id        String   @id @default(uuid(7)) @db.Uuid
    classId   String   @map("class_id") @db.Uuid
    name      String
    capacity  Int?
    isActive  Boolean  @default(true) @map("is_active")
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

    schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Restrict)

    classTeacherAssignments ClassTeacherAssignment[]
    teachingAssignments     TeachingAssignment[]
    enrollments             Enrollment[]
    attendanceSessions      AttendanceSession[]
    markSheets              MarkSheet[]
    promotionTargets        PromotionDecision[]

    @@unique([id, classId])
    @@unique([classId, name])
    @@map("sections")
}

model Subject {
    id        String   @id @default(uuid(7)) @db.Uuid
    code      String   @unique
    name      String
    isActive  Boolean  @default(true) @map("is_active")
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

    classSubjects ClassSubject[]

    @@map("subjects")
}

model ClassSubject {
    academicYearId String  @map("academic_year_id") @db.Uuid
    classId        String  @map("class_id") @db.Uuid
    subjectId      String  @map("subject_id") @db.Uuid
    isCompulsory   Boolean @default(true) @map("is_compulsory")

    academicYear        AcademicYear           @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
    schoolClass         SchoolClass            @relation(fields: [classId], references: [id], onDelete: Restrict)
    subject             Subject                @relation(fields: [subjectId], references: [id], onDelete: Restrict)
    teachingAssignments TeachingAssignment[]
    studentChoices      StudentSubjectChoice[]
    examSubjects        ExamSubject[]
    creditHours         Decimal?               @map("credit_hours") @db.Decimal(4, 2)

    @@id([academicYearId, classId, subjectId])
    @@index([classId])
    @@index([subjectId])
    @@map("class_subjects")
}
