enum FiscalYearStatus {
    OPEN
    CLOSED
}

enum FeeFrequency {
    ONE_TIME
    MONTHLY
    TERMLY
    YEARLY
    AD_HOC
}

enum FeeAudience {
    ALL
    NEW
    CONTINUING
}

model FiscalYear {
    id         String           @id @default(uuid(7)) @db.Uuid
    label      String           @unique
    startDate  DateTime         @map("start_date") @db.Date
    endDate    DateTime         @map("end_date") @db.Date
    status     FiscalYearStatus @default(OPEN)
    closedAt   DateTime?        @map("closed_at") @db.Timestamptz(6)
    closedById String?          @map("closed_by_id") @db.Uuid
    createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
    invoices   Invoice[]
    payments   Payment[]

    @@map("fiscal_years")
}

model FeeHead {
    id                String       @id @default(uuid(7)) @db.Uuid
    code              String       @unique
    name              String
    nameNp            String?      @map("name_np")
    /// The usual billing pattern. A hint and a guard, not a schedule.
    frequency         FeeFrequency
    /// true: billed only to students it is assigned to (transport, hostel).
    perStudent        Boolean      @default(false) @map("per_student")
    /// Link to the general ledger later.
    incomeAccountCode String?      @map("income_account_code")
    sortOrder         Int          @default(0) @map("sort_order")
    isActive          Boolean      @default(true) @map("is_active")
    createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

    structureLines FeeStructureLine[]
    assignments    StudentFeeAssignment[]
    discounts      StudentDiscount[]
    invoiceLines   InvoiceLine[]

    @@map("fee_heads")
}

model BillingPeriod {
    id             String   @id @default(uuid(7)) @db.Uuid
    academicYearId String   @map("academic_year_id") @db.Uuid
    sequence       Int
    name           String
    nameNp         String?  @map("name_np")
    startDate      DateTime @map("start_date") @db.Date
    endDate        DateTime @map("end_date") @db.Date
    dueDate        DateTime @map("due_date") @db.Date
    createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

    academicYear      AcademicYear                 @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
    lines             FeeStructureLinePeriod[]
    assignmentPeriods StudentFeeAssignmentPeriod[]
    discountsFrom     StudentDiscount[]            @relation("DiscountFrom")
    discountsTo       StudentDiscount[]            @relation("DiscountTo")
    invoices          Invoice[]

    @@unique([academicYearId, sequence])
    @@unique([academicYearId, name])
    @@unique([id, academicYearId])
    @@map("billing_periods")
}

model FeeStructureLine {
    id             String      @id @default(uuid(7)) @db.Uuid
    academicYearId String      @map("academic_year_id") @db.Uuid
    classId        String      @map("class_id") @db.Uuid
    feeHeadId      String      @map("fee_head_id") @db.Uuid
    amount         Decimal     @db.Decimal(12, 2)
    audience       FeeAudience @default(ALL)
    /// Billed once, when a new student is admitted (no billing periods).
    onAdmission    Boolean     @default(false) @map("on_admission")
    createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

    academicYear AcademicYear             @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
    schoolClass  SchoolClass              @relation(fields: [classId], references: [id], onDelete: Restrict)
    feeHead      FeeHead                  @relation(fields: [feeHeadId], references: [id], onDelete: Restrict)
    periods      FeeStructureLinePeriod[]

    @@unique([academicYearId, classId, feeHeadId, audience])
    @@unique([id, academicYearId])
    @@index([academicYearId, classId])
    @@map("fee_structure_lines")
}

model FeeStructureLinePeriod {
    lineId         String @map("line_id") @db.Uuid
    periodId       String @map("period_id") @db.Uuid
    academicYearId String @map("academic_year_id") @db.Uuid

    // The database guarantees the line and the period belong to the same academic year.
    line   FeeStructureLine @relation(fields: [lineId, academicYearId], references: [id, academicYearId], onDelete: Cascade)
    period BillingPeriod    @relation(fields: [periodId, academicYearId], references: [id, academicYearId], onDelete: Restrict)

    @@id([lineId, periodId])
    @@index([periodId])
    @@map("fee_structure_line_periods")
}

enum DiscountCategory {
    MERIT_SCHOLARSHIP
    NEED_SCHOLARSHIP
    SIBLING
    STAFF_CHILD
    MANAGEMENT
    OTHER
}

enum DiscountType {
    PERCENT
    FIXED_OFF
    PRICE_OVERRIDE
}

enum DiscountStatus {
    PENDING
    APPROVED
    REJECTED
    REVOKED
}

model StudentFeeAssignment {
    id           String   @id @default(uuid(7)) @db.Uuid
    enrollmentId String   @map("enrollment_id") @db.Uuid
    feeHeadId    String   @map("fee_head_id") @db.Uuid
    amount       Decimal  @db.Decimal(12, 2)
    note         String?
    createdById  String   @map("created_by_id") @db.Uuid
    createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

    enrollment Enrollment                   @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
    feeHead    FeeHead                      @relation(fields: [feeHeadId], references: [id], onDelete: Restrict)
    periods    StudentFeeAssignmentPeriod[]

    @@unique([id, enrollmentId, feeHeadId])
    @@index([enrollmentId])
    @@map("student_fee_assignments")
}

model StudentFeeAssignmentPeriod {
    assignmentId   String @map("assignment_id") @db.Uuid
    enrollmentId   String @map("enrollment_id") @db.Uuid
    feeHeadId      String @map("fee_head_id") @db.Uuid
    periodId       String @map("period_id") @db.Uuid
    academicYearId String @map("academic_year_id") @db.Uuid

    assignment StudentFeeAssignment @relation(fields: [assignmentId, enrollmentId, feeHeadId], references: [id, enrollmentId, feeHeadId], onDelete: Cascade)
    // The database guarantees the enrollment and the period belong to the same academic year.
    enrollment Enrollment           @relation(fields: [enrollmentId, academicYearId], references: [id, academicYearId], onDelete: Restrict)
    period     BillingPeriod        @relation(fields: [periodId, academicYearId], references: [id, academicYearId], onDelete: Restrict)

    @@id([assignmentId, periodId])
    // One head is never billed twice for the same student and period, even across two assignments.
    @@unique([enrollmentId, feeHeadId, periodId])
    @@index([periodId])
    @@map("student_fee_assignment_periods")
}

model StudentDiscount {
    id             String           @id @default(uuid(7)) @db.Uuid
    enrollmentId   String           @map("enrollment_id") @db.Uuid
    academicYearId String           @map("academic_year_id") @db.Uuid
    category       DiscountCategory
    /// null means the whole invoice.
    feeHeadId      String?          @map("fee_head_id") @db.Uuid
    type           DiscountType
    /// PERCENT: a percentage (2 decimals). FIXED_OFF: rupees off. PRICE_OVERRIDE: the price to charge instead.
    value          Decimal          @db.Decimal(12, 2)
    /// null on both: the whole academic year.
    fromPeriodId   String?          @map("from_period_id") @db.Uuid
    toPeriodId     String?          @map("to_period_id") @db.Uuid
    reason         String
    status         DiscountStatus   @default(PENDING)
    createdById    String           @map("created_by_id") @db.Uuid
    lastEditedById String           @map("last_edited_by_id") @db.Uuid
    createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
    approvedById   String?          @map("approved_by_id") @db.Uuid
    approvedAt     DateTime?        @map("approved_at") @db.Timestamptz(6)
    rejectedById   String?          @map("rejected_by_id") @db.Uuid
    rejectedAt     DateTime?        @map("rejected_at") @db.Timestamptz(6)
    rejectReason   String?          @map("reject_reason")
    revokedById    String?          @map("revoked_by_id") @db.Uuid
    revokedAt      DateTime?        @map("revoked_at") @db.Timestamptz(6)
    revokeReason   String?          @map("revoke_reason")

    enrollment          Enrollment     @relation(fields: [enrollmentId, academicYearId], references: [id, academicYearId], onDelete: Restrict)
    feeHead             FeeHead?       @relation(fields: [feeHeadId], references: [id], onDelete: Restrict)
    fromPeriod          BillingPeriod? @relation("DiscountFrom", fields: [fromPeriodId], references: [id], onDelete: Restrict)
    toPeriod            BillingPeriod? @relation("DiscountTo", fields: [toPeriodId], references: [id], onDelete: Restrict)
    lineDiscountUses    InvoiceLine[]  @relation("LineDiscount")
    invoiceDiscountUses InvoiceLine[]  @relation("InvoiceDiscount")

    @@index([enrollmentId, status])
    @@index([status, createdAt])
    @@map("student_discounts")
}

enum InvoiceKind {
    PERIODIC
    ADMISSION
    AD_HOC
}

enum ChargeSource {
    STRUCTURE
    ASSIGNMENT
    MANUAL
}

enum AdjustmentKind {
    WAIVER
    WRITE_OFF
    CORRECTION
}

/// Immutable once created: corrections are voids, reissues and credit notes.
model Invoice {
    id                String      @id @default(uuid(7)) @db.Uuid
    number            String      @unique
    fiscalYearId      String      @map("fiscal_year_id") @db.Uuid
    kind              InvoiceKind
    enrollmentId      String      @map("enrollment_id") @db.Uuid
    studentId         String      @map("student_id") @db.Uuid
    academicYearId    String      @map("academic_year_id") @db.Uuid
    periodId          String?     @map("period_id") @db.Uuid
    revision          Int         @default(1)
    replacesInvoiceId String?     @unique @map("replaces_invoice_id") @db.Uuid
    description       String?
    issuedOn          DateTime    @map("issued_on") @db.Date
    dueDate           DateTime    @map("due_date") @db.Date
    grossAmount       Decimal     @map("gross_amount") @db.Decimal(12, 2)
    discountAmount    Decimal     @map("discount_amount") @db.Decimal(12, 2)
    netAmount         Decimal     @map("net_amount") @db.Decimal(12, 2)
    createdById       String      @map("created_by_id") @db.Uuid
    /// Stops a double click from creating the same ad-hoc invoice twice.
    requestKey        String?     @unique @map("request_key")
    createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

    fiscalYear      FiscalYear          @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
    // The database guarantees the enrollment belongs to the academic year the invoice names.
    enrollment      Enrollment          @relation(fields: [enrollmentId, academicYearId], references: [id, academicYearId], onDelete: Restrict)
    student         Student             @relation(fields: [studentId], references: [id], onDelete: Restrict)
    period          BillingPeriod?      @relation(fields: [periodId], references: [id], onDelete: Restrict)
    replacesInvoice Invoice?            @relation("Reissue", fields: [replacesInvoiceId], references: [id], onDelete: Restrict)
    replacedBy      Invoice?            @relation("Reissue")
    lines           InvoiceLine[]
    void            InvoiceVoid?
    adjustments     InvoiceAdjustment[]
    allocations     PaymentAllocation[]

    @@index([enrollmentId])
    @@index([studentId])
    @@index([periodId])
    @@index([fiscalYearId, issuedOn])
    @@map("invoices")
}

model InvoiceLine {
    id                   String       @id @default(uuid(7)) @db.Uuid
    invoiceId            String       @map("invoice_id") @db.Uuid
    feeHeadId            String       @map("fee_head_id") @db.Uuid
    descriptionEn        String       @map("description_en")
    descriptionNp        String?      @map("description_np")
    source               ChargeSource
    grossAmount          Decimal      @map("gross_amount") @db.Decimal(12, 2)
    lineDiscount         Decimal      @map("line_discount") @db.Decimal(12, 2)
    invoiceDiscountShare Decimal      @map("invoice_discount_share") @db.Decimal(12, 2)
    netAmount            Decimal      @map("net_amount") @db.Decimal(12, 2)
    lineDiscountId       String?      @map("line_discount_id") @db.Uuid
    invoiceDiscountId    String?      @map("invoice_discount_id") @db.Uuid

    invoice         Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
    feeHead         FeeHead          @relation(fields: [feeHeadId], references: [id], onDelete: Restrict)
    lineDiscountRef StudentDiscount? @relation("LineDiscount", fields: [lineDiscountId], references: [id], onDelete: Restrict)
    invoiceDiscRef  StudentDiscount? @relation("InvoiceDiscount", fields: [invoiceDiscountId], references: [id], onDelete: Restrict)

    @@index([invoiceId])
    @@index([feeHeadId])
    @@map("invoice_lines")
}

model InvoiceVoid {
    invoiceId  String   @id @map("invoice_id") @db.Uuid
    reason     String
    voidedById String   @map("voided_by_id") @db.Uuid
    voidedAt   DateTime @default(now()) @map("voided_at") @db.Timestamptz(6)

    invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

    @@map("invoice_voids")
}

/// A credit note request. It reduces what is owed only once someone else approves it.
model InvoiceAdjustment {
    id            String         @id @default(uuid(7)) @db.Uuid
    invoiceId     String         @map("invoice_id") @db.Uuid
    kind          AdjustmentKind
    amount        Decimal        @db.Decimal(12, 2)
    reason        String
    requestedById String         @map("requested_by_id") @db.Uuid
    requestedAt   DateTime       @default(now()) @map("requested_at") @db.Timestamptz(6)

    invoice  Invoice                    @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
    decision InvoiceAdjustmentDecision?

    @@index([invoiceId])
    @@map("invoice_adjustments")
}

model InvoiceAdjustmentDecision {
    adjustmentId String   @id @map("adjustment_id") @db.Uuid
    approved     Boolean
    decidedById  String   @map("decided_by_id") @db.Uuid
    note         String?
    decidedAt    DateTime @default(now()) @map("decided_at") @db.Timestamptz(6)

    adjustment InvoiceAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)

    @@map("invoice_adjustment_decisions")
}

enum PaymentMethod {
    CASH
    BANK_TRANSFER
    CHEQUE
    ESEWA
    KHALTI
    FONEPAY_QR
}

/// Immutable once recorded. A mistake is a reversal, never an edit.
model Payment {
    id              String        @id @default(uuid(7)) @db.Uuid
    receiptNo       String        @unique @map("receipt_no")
    fiscalYearId    String        @map("fiscal_year_id") @db.Uuid
    paidOn          DateTime      @map("paid_on") @db.Date
    method          PaymentMethod
    /// Cheque number or transaction id. Required for every method except cash.
    reference       String?
    amount          Decimal       @db.Decimal(12, 2)
    payerGuardianId String?       @map("payer_guardian_id") @db.Uuid
    payerName       String?       @map("payer_name")
    /// The student who holds whatever was kept as advance credit.
    creditStudentId String?       @map("credit_student_id") @db.Uuid
    /// The cashier.
    receivedById    String        @map("received_by_id") @db.Uuid
    idempotencyKey  String        @unique @map("idempotency_key")
    note            String?
    createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

    fiscalYear    FiscalYear          @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
    payerGuardian Guardian?           @relation(fields: [payerGuardianId], references: [id], onDelete: Restrict)
    creditStudent Student?            @relation("CreditStudent", fields: [creditStudentId], references: [id], onDelete: Restrict)
    allocations   PaymentAllocation[]
    reversal      PaymentReversal?
    refunds       CreditRefund[]

    @@index([fiscalYearId, paidOn])
    @@index([receivedById, paidOn])
    @@index([creditStudentId])
    @@index([method, reference])
    @@map("payments")
}

model PaymentAllocation {
    id            String   @id @default(uuid(7)) @db.Uuid
    paymentId     String   @map("payment_id") @db.Uuid
    invoiceId     String   @map("invoice_id") @db.Uuid
    amount        Decimal  @db.Decimal(12, 2)
    allocatedById String   @map("allocated_by_id") @db.Uuid
    createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

    payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
    invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

    @@index([paymentId])
    @@index([invoiceId])
    @@map("payment_allocations")
}

model PaymentReversal {
    paymentId    String   @id @map("payment_id") @db.Uuid
    reason       String
    reversedById String   @map("reversed_by_id") @db.Uuid
    reversedAt   DateTime @default(now()) @map("reversed_at") @db.Timestamptz(6)

    payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

    @@map("payment_reversals")
}

/// Money handed back out of an unapplied advance credit.
model CreditRefund {
    id           String        @id @default(uuid(7)) @db.Uuid
    paymentId    String        @map("payment_id") @db.Uuid
    amount       Decimal       @db.Decimal(12, 2)
    method       PaymentMethod
    reference    String?
    reason       String
    approvedById String        @map("approved_by_id") @db.Uuid
    createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

    payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

    @@index([paymentId])
    @@map("credit_refunds")
}
