enum FiscalYearStatus {
    OPEN
    CLOSED
}

enum FeeFrequency {
    ONE_TIME
    MONTHLY
    TERMLY
    YEARLY
    AD_HOC
}

enum FeeAudience {
    ALL
    NEW
    CONTINUING
}

model FiscalYear {
    id         String           @id @default(uuid(7)) @db.Uuid
    label      String           @unique
    startDate  DateTime         @map("start_date") @db.Date
    endDate    DateTime         @map("end_date") @db.Date
    status     FiscalYearStatus @default(OPEN)
    closedAt   DateTime?        @map("closed_at") @db.Timestamptz(6)
    closedById String?          @map("closed_by_id") @db.Uuid
    createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

    @@map("fiscal_years")
}

model FeeHead {
    id                String       @id @default(uuid(7)) @db.Uuid
    code              String       @unique
    name              String
    nameNp            String?      @map("name_np")
    /// The usual billing pattern. A hint and a guard, not a schedule.
    frequency         FeeFrequency
    /// true: billed only to students it is assigned to (transport, hostel).
    perStudent        Boolean      @default(false) @map("per_student")
    /// Link to the general ledger later.
    incomeAccountCode String?      @map("income_account_code")
    sortOrder         Int          @default(0) @map("sort_order")
    isActive          Boolean      @default(true) @map("is_active")
    createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

    structureLines FeeStructureLine[]
    assignments    StudentFeeAssignment[]
    discounts      StudentDiscount[]

    @@map("fee_heads")
}

model BillingPeriod {
    id             String   @id @default(uuid(7)) @db.Uuid
    academicYearId String   @map("academic_year_id") @db.Uuid
    sequence       Int
    name           String
    nameNp         String?  @map("name_np")
    startDate      DateTime @map("start_date") @db.Date
    endDate        DateTime @map("end_date") @db.Date
    dueDate        DateTime @map("due_date") @db.Date
    createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

    academicYear      AcademicYear                 @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
    lines             FeeStructureLinePeriod[]
    assignmentPeriods StudentFeeAssignmentPeriod[]
    discountsFrom     StudentDiscount[]            @relation("DiscountFrom")
    discountsTo       StudentDiscount[]            @relation("DiscountTo")

    @@unique([academicYearId, sequence])
    @@unique([academicYearId, name])
    @@unique([id, academicYearId])
    @@map("billing_periods")
}

model FeeStructureLine {
    id             String      @id @default(uuid(7)) @db.Uuid
    academicYearId String      @map("academic_year_id") @db.Uuid
    classId        String      @map("class_id") @db.Uuid
    feeHeadId      String      @map("fee_head_id") @db.Uuid
    amount         Decimal     @db.Decimal(12, 2)
    audience       FeeAudience @default(ALL)
    /// Billed once, when a new student is admitted (no billing periods).
    onAdmission    Boolean     @default(false) @map("on_admission")
    createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

    academicYear AcademicYear             @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
    schoolClass  SchoolClass              @relation(fields: [classId], references: [id], onDelete: Restrict)
    feeHead      FeeHead                  @relation(fields: [feeHeadId], references: [id], onDelete: Restrict)
    periods      FeeStructureLinePeriod[]

    @@unique([academicYearId, classId, feeHeadId, audience])
    @@unique([id, academicYearId])
    @@index([academicYearId, classId])
    @@map("fee_structure_lines")
}

model FeeStructureLinePeriod {
    lineId         String @map("line_id") @db.Uuid
    periodId       String @map("period_id") @db.Uuid
    academicYearId String @map("academic_year_id") @db.Uuid

    // The database guarantees the line and the period belong to the same academic year.
    line   FeeStructureLine @relation(fields: [lineId, academicYearId], references: [id, academicYearId], onDelete: Cascade)
    period BillingPeriod    @relation(fields: [periodId, academicYearId], references: [id, academicYearId], onDelete: Restrict)

    @@id([lineId, periodId])
    @@index([periodId])
    @@map("fee_structure_line_periods")
}

enum DiscountCategory {
    MERIT_SCHOLARSHIP
    NEED_SCHOLARSHIP
    SIBLING
    STAFF_CHILD
    MANAGEMENT
    OTHER
}

enum DiscountType {
    PERCENT
    FIXED_OFF
    PRICE_OVERRIDE
}

enum DiscountStatus {
    PENDING
    APPROVED
    REJECTED
    REVOKED
}

model StudentFeeAssignment {
    id           String   @id @default(uuid(7)) @db.Uuid
    enrollmentId String   @map("enrollment_id") @db.Uuid
    feeHeadId    String   @map("fee_head_id") @db.Uuid
    amount       Decimal  @db.Decimal(12, 2)
    note         String?
    createdById  String   @map("created_by_id") @db.Uuid
    createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

    enrollment Enrollment                   @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
    feeHead    FeeHead                      @relation(fields: [feeHeadId], references: [id], onDelete: Restrict)
    periods    StudentFeeAssignmentPeriod[]

    @@unique([id, enrollmentId, feeHeadId])
    @@index([enrollmentId])
    @@map("student_fee_assignments")
}

model StudentFeeAssignmentPeriod {
    assignmentId   String @map("assignment_id") @db.Uuid
    enrollmentId   String @map("enrollment_id") @db.Uuid
    feeHeadId      String @map("fee_head_id") @db.Uuid
    periodId       String @map("period_id") @db.Uuid
    academicYearId String @map("academic_year_id") @db.Uuid

    assignment StudentFeeAssignment @relation(fields: [assignmentId, enrollmentId, feeHeadId], references: [id, enrollmentId, feeHeadId], onDelete: Cascade)
    // The database guarantees the enrollment and the period belong to the same academic year.
    enrollment Enrollment           @relation(fields: [enrollmentId, academicYearId], references: [id, academicYearId], onDelete: Restrict)
    period     BillingPeriod        @relation(fields: [periodId, academicYearId], references: [id, academicYearId], onDelete: Restrict)

    @@id([assignmentId, periodId])
    // One head is never billed twice for the same student and period, even across two assignments.
    @@unique([enrollmentId, feeHeadId, periodId])
    @@index([periodId])
    @@map("student_fee_assignment_periods")
}

model StudentDiscount {
    id             String           @id @default(uuid(7)) @db.Uuid
    enrollmentId   String           @map("enrollment_id") @db.Uuid
    academicYearId String           @map("academic_year_id") @db.Uuid
    category       DiscountCategory
    /// null means the whole invoice.
    feeHeadId      String?          @map("fee_head_id") @db.Uuid
    type           DiscountType
    /// PERCENT: a percentage (2 decimals). FIXED_OFF: rupees off. PRICE_OVERRIDE: the price to charge instead.
    value          Decimal          @db.Decimal(12, 2)
    /// null on both: the whole academic year.
    fromPeriodId   String?          @map("from_period_id") @db.Uuid
    toPeriodId     String?          @map("to_period_id") @db.Uuid
    reason         String
    status         DiscountStatus   @default(PENDING)
    createdById    String           @map("created_by_id") @db.Uuid
    lastEditedById String           @map("last_edited_by_id") @db.Uuid
    createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
    approvedById   String?          @map("approved_by_id") @db.Uuid
    approvedAt     DateTime?        @map("approved_at") @db.Timestamptz(6)
    rejectedById   String?          @map("rejected_by_id") @db.Uuid
    rejectedAt     DateTime?        @map("rejected_at") @db.Timestamptz(6)
    rejectReason   String?          @map("reject_reason")
    revokedById    String?          @map("revoked_by_id") @db.Uuid
    revokedAt      DateTime?        @map("revoked_at") @db.Timestamptz(6)
    revokeReason   String?          @map("revoke_reason")

    enrollment Enrollment     @relation(fields: [enrollmentId, academicYearId], references: [id, academicYearId], onDelete: Restrict)
    feeHead    FeeHead?       @relation(fields: [feeHeadId], references: [id], onDelete: Restrict)
    fromPeriod BillingPeriod? @relation("DiscountFrom", fields: [fromPeriodId], references: [id], onDelete: Restrict)
    toPeriod   BillingPeriod? @relation("DiscountTo", fields: [toPeriodId], references: [id], onDelete: Restrict)

    @@index([enrollmentId, status])
    @@index([status, createdAt])
    @@map("student_discounts")
}
